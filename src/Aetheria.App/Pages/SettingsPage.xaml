<Page
    x:Class="Aetheria.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
        <StackPanel Spacing="16">
            <!-- Appearance & Windows 11 Fluent Integration -->
            <Border Style="{StaticResource CardPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance &amp; Windows 11 Fluent Shell" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Application Theme (Mica Backdrop)" FontWeight="SemiBold" />
                            <TextBlock Text="Switch between Dark (Default), Light, or Windows System theme immediately across all workspaces."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="ThemeCombo" HorizontalAlignment="Stretch" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="Dark Theme (Default)" Tag="Dark" />
                            <ComboBoxItem Content="Light Theme" Tag="Light" />
                            <ComboBoxItem Content="Use Windows System Setting" Tag="Default" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Accessibility, Zoom, Typography & Ergonomics Center -->
            <Border Style="{StaticResource CardPanelStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Accessibility, Zoom &amp; Visual Ergonomics" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                            <TextBlock Text="Configure display scaling, roleplay reading fonts, dyslexia accommodations, and contrast settings."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset Accessibility Defaults" Click="ResetAccessibility_Click" />
                    </Grid>

                    <!-- Row 1: UI Zoom Scale -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Interface Display Zoom / Scale" FontWeight="SemiBold" />
                            <TextBlock Text="Scales all visual controls and workspaces smoothly. Shortcut: Ctrl+Plus, Ctrl+Minus, Ctrl+0."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="ZoomScaleCombo" HorizontalAlignment="Stretch" SelectionChanged="ZoomScaleCombo_SelectionChanged">
                            <ComboBoxItem Content="80% (Compact)" Tag="80" />
                            <ComboBoxItem Content="90% (Small)" Tag="90" />
                            <ComboBoxItem Content="100% (Default - Standard)" Tag="100" />
                            <ComboBoxItem Content="110% (Comfortable)" Tag="110" />
                            <ComboBoxItem Content="125% (Large Display)" Tag="125" />
                            <ComboBoxItem Content="150% (High-DPI / Accessible)" Tag="150" />
                            <ComboBoxItem Content="175% (Extra Large)" Tag="175" />
                            <ComboBoxItem Content="200% (Maximum Scale)" Tag="200" />
                        </ComboBox>
                    </Grid>

                    <!-- Row 2: Roleplay Message Font Size -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Roleplay Message Font Size" FontWeight="SemiBold" />
                            <TextBlock Text="Adjusts text size for character dialogue, descriptions, and story cards."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="FontSizeCombo" HorizontalAlignment="Stretch" SelectionChanged="FontSizeCombo_SelectionChanged">
                            <ComboBoxItem Content="12px (Small &amp; Compact)" Tag="12" />
                            <ComboBoxItem Content="14px (Default Standard)" Tag="14" />
                            <ComboBoxItem Content="16px (Medium Comfort)" Tag="16" />
                            <ComboBoxItem Content="18px (Large Accessible)" Tag="18" />
                            <ComboBoxItem Content="22px (Extra Large)" Tag="22" />
                            <ComboBoxItem Content="26px (Maximum Visibility)" Tag="26" />
                        </ComboBox>
                    </Grid>

                    <!-- Row 3: Font Family / Dyslexia -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Typography &amp; Dyslexia-Friendly Font" FontWeight="SemiBold" />
                            <TextBlock Text="Choose between clean Windows Fluent typography, high-legibility sans-serif, or dyslexia-friendly spacing."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="FontFamilyCombo" HorizontalAlignment="Stretch" SelectionChanged="FontFamilyCombo_SelectionChanged">
                            <ComboBoxItem Content="Default Fluent (Segoe UI Variable)" Tag="Default" />
                            <ComboBoxItem Content="Dyslexia-Friendly (Comic Sans / Open)" Tag="Dyslexic" />
                            <ComboBoxItem Content="Clean Sans-Serif (Arial / Segoe)" Tag="SansSerif" />
                            <ComboBoxItem Content="Monospaced / Typewriter (Consolas)" Tag="Monospace" />
                        </ComboBox>
                    </Grid>

                    <!-- Toggles: Line Spacing, High Contrast, Reduce Motion, TTS -->
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleSwitch Grid.Row="0" Grid.Column="0" x:Name="ExpandedLineSpacingToggle"
                                      Header="Expanded Line Spacing"
                                      OffContent="Standard Line Height" OnContent="Relaxed (1.85x) Line Height"
                                      Toggled="ExpandedLineSpacing_Toggled" />

                        <ToggleSwitch Grid.Row="0" Grid.Column="1" x:Name="HighContrastCardsToggle"
                                      Header="High-Contrast Message Borders"
                                      OffContent="Subtle Border" OnContent="High-Contrast Accent Borders"
                                      Toggled="HighContrastCards_Toggled" />

                        <ToggleSwitch Grid.Row="1" Grid.Column="0" x:Name="ReduceMotionToggle"
                                      Header="Reduce Motion &amp; Transitions"
                                      OffContent="Smooth Animations" OnContent="Instant Page &amp; Message Rendering"
                                      Toggled="ReduceMotion_Toggled" />

                        <ToggleSwitch Grid.Row="1" Grid.Column="1" x:Name="EnableTtsToggle"
                                      Header="Speech Narration (TTS Aloud)"
                                      OffContent="Silent Reading" OnContent="Enable '🔊 Listen' On Messages"
                                      Toggled="EnableTts_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hardware Tuning Advisor (Xeon E5-2690 v3 + RX 580 8GB) -->
            <Border Style="{StaticResource CardPanelStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hardware Optimization Profile: Xeon E5-2690 v3 (12C/24T) + AMD RX 580 8GB + 16GB RAM"
                                   Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                        <Button Grid.Column="1" Content="Copy KoboldCpp Vulkan Command" Click="CopyVulkanCmd_Click" />
                    </Grid>
                    <TextBlock Text="• AMD Radeon RX 580 8GB (GCN 4.0 Polaris): Native ROCm is dropped on newer drivers, so Vulkan backend is fastest. Use 7B–9B parameter models in Q4_K_M or Q5_K_M quantization (~4.8–5.8 GB VRAM) to fit 100% of layers in 8GB VRAM alongside a 4096-token KV cache."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="• Intel Xeon E5-2690 v3 (12 Cores / 24 Threads, AVX2): For larger 12B–14B models (e.g., Mistral-Nemo-12B-Q4_K_M), offload 26/40 layers to RX 580 Vulkan and run remaining layers across 10 physical Xeon AVX2 threads (--threads 10 --blasthreads 10)."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Storage, SQLite Persistence & Security -->
            <Border Style="{StaticResource CardPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Local Storage, SQLite WAL Persistence &amp; Credential Security" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Local AppData Storage Directory" FontWeight="SemiBold" />
                            <TextBlock x:Name="DataDirPathText" Text="%LOCALAPPDATA%\Aetheria" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open AppData Folder" Click="OpenDataFolder_Click" />
                        <Button Grid.Column="2" Content="Backup SQLite Database..." Style="{StaticResource AccentButtonStyle}" Click="BackupDatabase_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live Diagnostic Logs -->
            <Border Style="{StaticResource CardPanelStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Platform Diagnostic Logs" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                        <Button Grid.Column="1" Content="Refresh Logs" Margin="0,0,8,0" Click="RefreshLogs_Click" />
                        <Button Grid.Column="2" Content="Copy Logs" Click="CopyLogs_Click" />
                    </Grid>
                    <ListView x:Name="LogsListView" MaxHeight="220" SelectionMode="None" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
