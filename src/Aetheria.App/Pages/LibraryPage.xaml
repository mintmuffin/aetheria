<Page
    x:Class="Aetheria.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
        <StackPanel Spacing="16">
            <!-- Top Universal Importer & Samples Bar -->
            <Border Style="{StaticResource CardPanelStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Content Library &amp; Resource Bundle Studio (.rpack)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Import and export versioned Aetheria packages (.rpack, .rpchar, .rpworld, .rppersona, .rpmodel, .rpsession) with schema validation, secret stripping, and zip-traversal protection."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Open Samples Folder" Click="OpenSamplesFolder_Click" />
                        <Button Content="Universal Import Package..." Style="{StaticResource AccentButtonStyle}" Click="UniversalImport_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Split Grid: Bundle Builder vs Library Inspector -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: .rpack Bundle Builder -->
                <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Create &amp; Export Multi-Asset Bundle (.rpack)" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                        <TextBlock Text="Combine worlds, characters, personas, and secret-free model presets into a single portable .rpack archive to share with friends."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="BundleTitleBox" Header="Bundle Title" Text="Aetheria Roleplay Expansion Pack" />
                            <TextBox Grid.Column="1" x:Name="BundleAuthorBox" Header="Author" Text="Roleplay Architect" />
                        </Grid>

                        <TextBox x:Name="BundleDescBox" Header="Bundle Description" Text="Complete world, character roster, and tuned model preset." />
                        <TextBox x:Name="BundleTagsBox" Header="Tags (comma-separated)" Text="Fantasy, Co-Op, Starter" />

                        <TextBlock Text="Select Worlds to Include:" FontWeight="SemiBold" FontSize="12" />
                        <ListView x:Name="BundleWorldsList" SelectionMode="Multiple" MaxHeight="110" />

                        <TextBlock Text="Select Characters to Include:" FontWeight="SemiBold" FontSize="12" />
                        <ListView x:Name="BundleCharsList" SelectionMode="Multiple" MaxHeight="120" />

                        <TextBlock Text="Select Personas &amp; Model Presets to Include:" FontWeight="SemiBold" FontSize="12" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListView Grid.Column="0" x:Name="BundlePersonasList" SelectionMode="Multiple" MaxHeight="110" />
                            <ListView Grid.Column="1" x:Name="BundleModelsList" SelectionMode="Multiple" MaxHeight="110" />
                        </Grid>

                        <Button Content="Package &amp; Export .rpack Archive" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="ExportBundle_Click" />
                    </StackPanel>
                </Border>

                <!-- Right: Installed Content Catalog & Validation Inspector -->
                <Border Grid.Column="1" Style="{StaticResource CardPanelStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Installed Assets &amp; Sample Packages" Style="{StaticResource SectionHeaderTextStyle}" Margin="0" />
                            <Button Grid.Column="1" Content="Refresh Catalog" Click="RefreshCatalog_Click" />
                        </Grid>

                        <TextBox x:Name="CatalogSearchBox" PlaceholderText="Search installed worlds, characters, personas, models, and sample files..." TextChanged="CatalogSearchBox_TextChanged" />

                        <ListView x:Name="CatalogListView" MaxHeight="280" SelectionMode="Single" />

                        <TextBlock Text="Package Validation &amp; Schema Migration Report" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" MinHeight="120">
                            <TextBlock x:Name="ValidationReportText"
                                       Text="Ready. All Aetheria packages use envelope header 'AETHERIA_RP_FORMAT' (Schema 1.0, backward-compatible with 0.9). Executable files and path-traversal entries inside .rpack archives are automatically rejected."
                                       FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
