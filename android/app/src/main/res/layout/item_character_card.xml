<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/card_rounded_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_char_card_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="D"
            android:textColor="@color/md_onPrimaryContainer"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/avatar_circle_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_char_card_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Character Name"
                android:textColor="@color/md_onSurface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_char_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title / Role"
                android:textColor="@color/md_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_char_card_chat"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Roleplay"
            android:textColor="@color/md_onPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary_bg" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_char_card_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Character description text..."
        android:textColor="@color/md_onSurfaceVariant"
        android:textSize="13sp"
        android:maxLines="3" />

    <TextView
        android:id="@+id/tv_char_card_tags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="Tags"
        android:textColor="@color/md_secondary"
        android:textSize="11sp"
        android:background="@drawable/chip_pill_bg" />

</LinearLayout>
